# ============================================================================
# FastBlog Environment Configuration
# ============================================================================
# Copy this file to .env and modify the values
# cp .env.example .env
#
# ⚠️  IMPORTANT: Change ALL default passwords and secret keys in production!
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=fast_blog
DB_TABLE_PREFIX=fb_

# Connection pool settings
DB_POOL_SIZE=20
DB_POOL_OVERFLOW=30
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
DOMAIN=http://localhost:9421
TITLE=FastBlog
DESCRIPTION=A modern, fast blog platform
KEYWORDS=blog,fast,modern

# Security
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
TIME_ZONE=Asia/Shanghai
# 生产上线请改为 production / False：DEBUG=True 会加载调试中间件并输出请求头
ENVIRONMENT=development
DEBUG=True

# 反向代理（置于 nginx / 容器网关之后时必须配置）
# 只信任该地址来源的 X-Forwarded-* 头，否则 request.url.scheme 恒为 http，
# Secure Cookie 永不下发。Docker 网段示例：172.16.0.0/12
FORWARDED_ALLOW_IPS=127.0.0.1

# 出站请求安全开关
# 默认禁止访问内网/回环地址（防 SSRF）。若使用本地 Ollama 等内网 LLM，
# 显式设为 true，并确保该端点只对可信用户开放。
OUTBOUND_ALLOW_PRIVATE=false

# 应用层限流（slowapi）。默认仅在登录/注册等敏感路由上限额；
# 如需全局限额可设为 600/minute，多实例部署请同时配置 RATE_LIMIT_STORAGE_URI
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_HEADERS=false

# JWT Authentication
JWT_EXPIRATION_DELTA=86400
REFRESH_TOKEN_EXPIRATION_DELTA=604800
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256

# 认证 Cookie 策略（登录 / 2FA / OAuth / 续期 四处统一下发）
# JWT_COOKIE_SECURE: 仅当请求确实走 https 时才给 Cookie 加 Secure
JWT_COOKIE_SECURE=True
# 可选 strict / lax / none（none 必须搭配 Secure，用于跨站场景）
JWT_COOKIE_SAMESITE=lax
# 说明：access_token 当前为 httponly=False，因为前端从 document.cookie 读取令牌
# 并放入 Authorization 头。改为 HttpOnly 需前端切换为纯 Cookie 认证流程。
JWT_COOKIE_CSRF_PROTECT=True

# ----------------------------------------------------------------------------
# Redis (Cache & Sessions)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Cache TTL (seconds)
CACHE_TTL_DEFAULT=600
CACHE_TTL_ARTICLES=3600
CACHE_TTL_USERS=1800

# ----------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@fastblog.com
MAIL_FROM_NAME=FastBlog

# ----------------------------------------------------------------------------
# File Storage
# ----------------------------------------------------------------------------
UPLOAD_LIMIT=62914560
USER_FREE_STORAGE_LIMIT=536870912

# S3-compatible storage (optional)
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=

# ----------------------------------------------------------------------------
# Search (Meilisearch - optional)
# ----------------------------------------------------------------------------
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=your_master_key

# ----------------------------------------------------------------------------
# Error Tracking (Sentry - optional)
# ----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
FRONTEND_PORT=4321
BACKEND_PORT=9421
